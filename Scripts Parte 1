# Instalar dependencias necesarias
sudo apt update -y
sudo apt install -y apache2 libapache2-mod-authnz-pam

# Crear directorio protegido
sudo mkdir /var/www/html/archivos_privados

# Configurar el VirtualHost de Apache
sudo vim /etc/apache2/sites-available/000-default.conf
Se agrega lo siguiente:
<Directory "/var/www/html/archivos_privados">
    AuthType Basic
    AuthName "Zona Privada"
    AuthBasicProvider PAM
    AuthPAMService apache
    Require valid-user
</Directory>

# Configurar PAM
sudo vim /etc/pam.d/apache
Se agrega lo siguiente:
auth    required pam_listfile.so item=user sense=deny file=/etc/denied_users onerr=succeed
auth    required pam_unix.so nullok
account required pam_unix.so
session required pam_unix.so

# Habilitar el módulo PAM en Apache
sudo a2enmod authnz_pam

# Crrar lista usuarios bloqueados
echo "usuario1" | sudo tee -a /etc/denied_users
echo "usuario2" | sudo tee -a /etc/denied_users
echo "usuario3" | sudo tee -a /etc/denied_users
echo "denegado" | sudo tee -a /etc/denied_users

# Crear usuario con acceso
sudo adduser permitido
clave: 12345

# Reiniciar Apache
sudo systemctl restart apache2

# Probar desde consola con curl (Usuario con acceso)
curl -u permitido:12345 http://192.168.50.3/archivos_privados/

# Crear pagina de bienvenida
sudo vim /var/www/html/archivos_privados/index.html
